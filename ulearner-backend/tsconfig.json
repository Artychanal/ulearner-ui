{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "paths": {
      "@adminjs/design-system": ["./node_modules/@adminjs/design-system/types/src/index.d.ts"]
    },
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "exclude": ["node_modules", "dist"]
}
